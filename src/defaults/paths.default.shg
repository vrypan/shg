# shg history paths
# One path per line. A leading ~/ expands to your home directory.
~/.zsh_history
~/.bash_history
~/.local/share/fish/fish_history
~/.config/fish/fish_history
~/.python_history
~/.psql_history
~/.mysql_history
~/.sqlite_history
~/.rediscli_history
~/.node_repl_history
~/.irb_history
~/.pry_history
~/.Rhistory
